<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="#F5F8F6" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <Button android:id="@+id/voltar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Voltar" android:textColor="#073E2D" android:textAllCaps="false" />
    <TextView style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Novo cliente" android:layout_marginTop="12dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Preencha os três campos para cadastrar." android:textColor="#52675D" android:layout_marginTop="8dp" />
    <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nome completo" android:labelFor="@id/nome" />
    <EditText android:id="@+id/nome" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textPersonName|textCapWords" android:hint="Ex.: João Silva" android:maxLength="100" android:singleLine="true" />
    <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="E-mail" android:labelFor="@id/email" />
    <EditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textEmailAddress" android:hint="Ex.: joao@example.com" android:maxLength="120" android:singleLine="true" />
    <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Telefone com DDD" android:labelFor="@id/telefone" />
    <EditText android:id="@+id/telefone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="phone" android:hint="Ex.: (61) 99999-1234" android:maxLength="20" android:singleLine="true" />
    <TextView android:id="@+id/erro" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A32626" android:accessibilityLiveRegion="polite" android:visibility="gone" android:layout_marginTop="12dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Os cadastros ficam na memória. Se o processo do aplicativo for encerrado, os dados serão perdidos." android:textColor="#52675D" android:layout_marginTop="20dp" />
    <Button android:id="@+id/salvar" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Salvar cliente" android:layout_marginTop="20dp" />
</LinearLayout>
</ScrollView>
