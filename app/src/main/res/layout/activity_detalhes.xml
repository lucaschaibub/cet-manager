<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="#F5F8F6" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <Button android:id="@+id/voltar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Voltar" android:textColor="#073E2D" android:textAllCaps="false" />
    <TextView style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Detalhes do cliente" android:layout_marginTop="12dp" />
    <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nome" />
    <TextView android:id="@+id/detalhe_nome" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#073E2D" android:textIsSelectable="true" />
    <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="E-mail" />
    <TextView android:id="@+id/detalhe_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#073E2D" android:textIsSelectable="true" />
    <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Telefone" />
    <TextView android:id="@+id/detalhe_telefone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#073E2D" android:textIsSelectable="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:layout_marginTop="24dp">
        <TextView android:id="@+id/situacao_titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#344E42" />
        <TextView android:id="@+id/situacao" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/situacao_detalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#52675D" android:layout_marginTop="4dp" />
    </LinearLayout>
    <Button android:id="@+id/registrar_pagamento" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registrar pagamento" android:layout_marginTop="16dp" />
    <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Histórico de pagamentos" android:textStyle="bold" android:layout_marginTop="24dp" />
    <TextView android:id="@+id/historico_vazio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nenhum pagamento registrado nesta sessão." android:textColor="#52675D" android:layout_marginTop="8dp" />
    <LinearLayout android:id="@+id/historico" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card" android:layout_marginTop="24dp" android:text="Dados disponíveis nesta sessão.

Edição do cadastro, situação cadastral e arquivamento serão desenvolvidos nas próximas etapas." android:textColor="#52675D" />
</LinearLayout>
</ScrollView>
