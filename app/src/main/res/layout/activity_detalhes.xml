<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="#F5F8F6" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <Button android:id="@+id/voltar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Voltar" android:textColor="#073E2D" android:textAllCaps="false" />
    <TextView style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Detalhes do cliente" android:layout_marginTop="12dp" />
    <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nome" />
    <TextView android:id="@+id/detalhe_nome" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#073E2D" android:textIsSelectable="true" />
    <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="E-mail" />
    <TextView android:id="@+id/detalhe_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#073E2D" android:textIsSelectable="true" />
    <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Telefone" />
    <TextView android:id="@+id/detalhe_telefone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#073E2D" android:textIsSelectable="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card" android:layout_marginTop="28dp" android:text="Cadastro disponível nesta sessão.

O acompanhamento de mensalidades e a situação financeira serão desenvolvidos na próxima etapa." android:textColor="#52675D" />
</LinearLayout>
</ScrollView>
