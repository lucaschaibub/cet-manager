<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="#F5F8F6" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CET MANAGER" android:textSize="13sp" android:textStyle="bold" android:textColor="#006C4C" />
    <TextView style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Clientes" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cadastre e encontre os contatos da consultoria." android:textColor="#52675D" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/session_notice" android:textSize="12sp" android:paddingTop="12dp" android:paddingBottom="12dp" android:textColor="#52675D" />
    <EditText android:id="@+id/busca" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Buscar por nome ou e-mail" android:inputType="text" android:singleLine="true" android:maxLength="120" />
    <TextView android:id="@+id/contador" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:textColor="#52675D" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/lista" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="10dp" />
        <TextView android:id="@+id/vazio" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="20dp" android:textSize="17sp" android:textColor="#52675D" />
    </FrameLayout>
    <Button android:id="@+id/novo" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ Novo cliente" android:layout_marginTop="12dp" />
</LinearLayout>
