<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#006C4C</item>
        <item name="android:statusBarColor">#003D2C</item>
        <item name="android:navigationBarColor">#003D2C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#F5F8F6</item>
        <item name="android:colorControlNormal">#52675D</item>
    </style>
    <style name="Title"><item name="android:textSize">28sp</item><item name="android:textColor">#073E2D</item><item name="android:textStyle">bold</item></style>
    <style name="Label"><item name="android:textSize">14sp</item><item name="android:textColor">#344E42</item><item name="android:layout_marginTop">16dp</item></style>
    <style name="PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">#006C4C</item><item name="android:textColor">#FFFFFF</item><item name="android:textAllCaps">false</item><item name="android:minHeight">52dp</item>
    </style>
</resources>
